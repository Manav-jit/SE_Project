        <mxCell id="conn_net_data" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;endFill=0;strokeWidth=2;strokeColor=#0000FF;" edge="1" parent="1" source="node_network2" target="node_datastore">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== BOTTOM ROW — FRONTEND PAGES (3D cube) ==================== -->
        <mxCell id="node_frontend" value="«processor»&lt;br&gt;&lt;b&gt;Frontend (SSR + CSR)&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;i&gt;page.tsx (Home)&lt;br&gt;chat/page.tsx&lt;br&gt;wizard/page.tsx&lt;br&gt;dashboard/page.tsx&lt;br&gt;matches/page.tsx&lt;/i&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=10;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="680" width="180" height="160" as="geometry" />
