        <!-- UI Components -->
        <mxCell id="node_components" value="«processor»&lt;br&gt;&lt;b&gt;UI Components&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;i&gt;SchemeCard.tsx&lt;br&gt;ChatInput.tsx&lt;br&gt;ChatMessage.tsx&lt;br&gt;DigiLockerModal.tsx&lt;br&gt;ActionPlanModal.tsx&lt;/i&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=10;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="340" y="680" width="190" height="160" as="geometry" />
        </mxCell>

        <!-- Chat Service (prompts + profile) -->
        <mxCell id="node_chat_service" value="«processor»&lt;br&gt;&lt;b&gt;Chat Service&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;i&gt;chat/prompts.ts&lt;br&gt;chat/profile.ts&lt;br&gt;(System + Extraction)&lt;/i&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=10;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="590" y="680" width="180" height="150" as="geometry" />
        </mxCell>

        <!-- Scheme Loader -->
        <mxCell id="node_loader" value="«processor»&lt;br&gt;&lt;b&gt;Scheme Loader&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;i&gt;schemes/loader.ts&lt;br&gt;(JSON → Scheme[])&lt;/i&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=10;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="830" y="690" width="170" height="120" as="geometry" />
        </mxCell>

        <!-- Connection: API → Frontend -->
