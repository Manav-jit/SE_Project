        <mxCell id="conn_net_rag" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;endFill=0;strokeWidth=2;strokeColor=#0000FF;" edge="1" parent="1" source="node_network2" target="node_rag">
          <mxGeometry relative="1" as="geometry" />
