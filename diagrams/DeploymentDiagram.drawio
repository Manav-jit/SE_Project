          <mxGeometry x="370" y="115" width="80" height="30" as="geometry" />
        </mxCell>

        <!-- Arrow from "connection" label to the conn line -->
        <mxCell id="label_conn_arrow" style="rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeWidth=1;strokeColor=#FF0000;curved=1;dashed=0;" edge="1" parent="1" source="label_connection" target="conn_client_internet">
