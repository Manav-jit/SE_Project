<mxfile host="app.diagrams.net" pages="1">
  <diagram id="deployment-diagram" name="Deployment Diagram">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ==================== TITLE ==================== -->
        <mxCell id="title" value="Deployment Diagram" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="500" y="15" width="280" height="40" as="geometry" />
        </mxCell>

        <!-- ==================== INTERNET CLOUD ==================== -->
        <mxCell id="cloud_internet" value="Internet" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#C0C0C0;strokeColor=#808080;fontSize=13;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="540" y="70" width="180" height="100" as="geometry" />
        </mxCell>

        <!-- ==================== TOP ROW — CLIENT BROWSER ==================== -->
        <mxCell id="node_client" value="«device»&lt;br&gt;&lt;b&gt;Client Browser&lt;/b&gt;&lt;br&gt;&lt;i&gt;(Chrome / Firefox / Safari)&lt;/i&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=10;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="140" y="90" width="190" height="90" as="geometry" />
        </mxCell>

        <!-- ==================== TOP ROW — EXTERNAL SERVICES ==================== -->
        <mxCell id="node_groq" value="«cloud service»&lt;br&gt;&lt;b&gt;Groq LLM API&lt;/b&gt;&lt;br&gt;&lt;i&gt;(api.groq.com)&lt;/i&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=10;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="950" y="70" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="node_digilocker" value="«cloud service»&lt;br&gt;&lt;b&gt;DigiLocker API&lt;/b&gt;&lt;br&gt;&lt;i&gt;(Govt. Document Vault)&lt;/i&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=10;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="950" y="180" width="190" height="80" as="geometry" />
        </mxCell>

        <mxCell id="node_hf" value="«cloud service»&lt;br&gt;&lt;b&gt;Hugging Face Hub&lt;/b&gt;&lt;br&gt;&lt;i&gt;(Model Download)&lt;/i&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=10;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="950" y="290" width="190" height="80" as="geometry" />
        </mxCell>

        <!-- Connection: Client → Internet -->
        <mxCell id="conn_client_internet" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;endFill=0;strokeWidth=2;strokeColor=#0000FF;" edge="1" parent="1" source="node_client" target="cloud_internet">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Connection: Groq → Internet -->
        <mxCell id="conn_groq_internet" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;endFill=0;strokeWidth=2;strokeColor=#0000FF;" edge="1" parent="1" source="node_groq" target="cloud_internet">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Connection: DigiLocker → Internet -->
        <mxCell id="conn_digi_internet" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;endFill=0;strokeWidth=2;strokeColor=#0000FF;" edge="1" parent="1" source="node_digilocker" target="cloud_internet">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Connection: HF → Internet -->
        <mxCell id="conn_hf_internet" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;endFill=0;strokeWidth=2;strokeColor=#0000FF;" edge="1" parent="1" source="node_hf" target="cloud_internet">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== VERCEL / APP HOST NODE ==================== -->
        <mxCell id="node_vercel" value="«device»&lt;br&gt;&lt;b&gt;Vercel / Node.js Host&lt;/b&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=10;fontSize=12;fontStyle=0;verticalAlign=top;align=center;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="300" y="230" width="570" height="100" as="geometry" />
        </mxCell>

        <!-- Next.js Runtime inside Vercel -->
        <mxCell id="node_nextjs" value="«executionEnvironment»&lt;br&gt;&lt;b&gt;Next.js 16 (App Router) — Node.js Runtime&lt;/b&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=8;fontSize=10;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="340" y="270" width="490" height="50" as="geometry" />
        </mxCell>

        <!-- Connection: Internet → Vercel host -->
        <mxCell id="conn_internet_vercel" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;endFill=0;strokeWidth=2;strokeColor=#0000FF;" edge="1" parent="1" source="cloud_internet" target="node_vercel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== NETWORK BAR ==================== -->
        <mxCell id="node_network" value="«network»  internal application bus" style="shape=mxgraph.cisco.misc.apertus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontStyle=1;verticalAlign=middle;align=center;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="140" y="395" width="900" height="40" as="geometry" />
        </mxCell>

        <!-- Simpler network bar as a flat rectangle -->
        <mxCell id="node_network2" value="«network»  Internal Application Network" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="120" y="390" width="940" height="35" as="geometry" />
        </mxCell>

        <!-- Connection: Vercel → Network -->
        <mxCell id="conn_vercel_network" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;endFill=0;strokeWidth=2;strokeColor=#0000FF;" edge="1" parent="1" source="node_vercel" target="node_network2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== BOTTOM ROW — SERVER COMPONENTS (3D cubes) ==================== -->

        <!-- API Server -->
        <mxCell id="node_api_server" value="«processor»&lt;br&gt;&lt;b&gt;API Server&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;i&gt;/api/chat&lt;br&gt;/api/schemes&lt;br&gt;/api/generate-pdf&lt;/i&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=10;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="490" width="180" height="130" as="geometry" />
        </mxCell>

        <!-- RAG Engine -->
        <mxCell id="node_rag" value="«processor»&lt;br&gt;&lt;b&gt;RAG Engine&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;i&gt;retriever.ts&lt;br&gt;embeddings.ts&lt;br&gt;(Xenova/MiniLM-L6-v2)&lt;/i&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=10;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="340" y="490" width="190" height="130" as="geometry" />
        </mxCell>

        <!-- PDF Service -->
        <mxCell id="node_pdf" value="«processor»&lt;br&gt;&lt;b&gt;PDF Service&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;i&gt;pdf/generator.ts&lt;br&gt;(pdf-lib)&lt;/i&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=10;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="590" y="490" width="170" height="130" as="geometry" />
        </mxCell>

        <!-- Data Store -->
        <mxCell id="node_datastore" value="«dataStore»&lt;br&gt;&lt;b&gt;Scheme Data&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;i&gt;data/schemes/*.json&lt;br&gt;(6 JSON files)&lt;br&gt;data/templates/&lt;/i&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=10;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="820" y="490" width="180" height="130" as="geometry" />
        </mxCell>

        <!-- Connections: Network → Bottom row nodes -->
        <mxCell id="conn_net_api" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;endFill=0;strokeWidth=2;strokeColor=#0000FF;" edge="1" parent="1" source="node_network2" target="node_api_server">
